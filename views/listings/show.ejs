<% layout('layouts/boilerplate') %>

<div class="container mt-4">

  <!-- Heading -->
  <div class="row mb-3">
    <div class="col-md-8 offset-md-3">
      <h3><%= listing.title %></h3>
    </div>
  </div>

  <!-- Listing Card -->
  <div class="row">
    <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
      <div class="card shadow-sm">

        <img 
          src="<%= listing.image %>" 
          class="card-img-top show-img" 
          alt="Listing Image"
        >

        <div class="card-body">
          <h5 class="card-title"></h5>

          <p class="card-text text-muted">
            <%= listing.description %>
          </p>

          <p class="card-text">
            <strong>Price:</strong> ₹<%= listing.price %><br>
            <strong>Location:</strong> <%= listing.location %><br>
            <strong>Country:</strong> <%= listing.country %>
          </p>
        </div>

      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="row mt-3">
    <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3 d-flex gap-2">

      <a 
        href="/listings/<%= listing._id %>/edit" 
        class="btn btn-dark"
      >
        Edit
      </a>

      <form 
        method="POST" 
        action="/listings/<%= listing._id %>?_method=DELETE"
      >
        <button class="btn btn-danger">
          Delete
        </button>
      </form>

    </div>
    <div class="col-8 offset-3 mb-3">
      <hr/>
      <h4>Leave a Review</h4>
      <form action="/listings/<%= listing._id %>/reviews" method="POST">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
        </div>
        <div class="mb-3 mt-3">
          <label for="comment">Comment</label>
          <textarea id="comment" name="review[comment]" rows="5" cols="30" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn btn-outline-dark">Submit Review</button>
      </form>
    </div>
  </div>

</div>
