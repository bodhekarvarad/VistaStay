<% layout('layouts/boilerplate') %>
<script>
  const mapToken="<%= process.env.MAPBOX_TOKEN %>";
  const listing="<%- JSON.stringify(listing) %>";
  </script>
<div class="container mt-4">

  <!-- Heading -->
  <div class="text-center mb-4">
    <h2><%= listing.title %></h2>
  </div>

  <!-- Listing Card -->
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-sm listing-card">

        <img 
          src="<%= listing.image.url%>" 
          class="card-img-top show-img"
          alt="Listing Image"
        >

        <div class="card-body">
          <p><%= listing.description %></p>

          <p class="card-text">
            <strong>Price:</strong> ₹<%= listing.price %> <br>
            <strong>Location:</strong> <%= listing.location %> <br>
            <strong>Country:</strong> <%= listing.country %>
          </p>
        </div>

      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="row justify-content-center mt-3">
    <div class="col-md-8 col-lg-6 d-flex justify-content-between">

      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
        Edit
      </a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-danger">Delete</button>
      </form>

    </div>
  </div>

  <!-- Review Form -->
  <% if(currUser) { %>
    <div class="row justify-content-center mt-5">
      <div class="col-md-8 col-lg-6">
        <hr>
        <h4 class="mb-3">Leave a Review</h4>

        <form 
          action="/listings/<%= listing._id %>/reviews" 
          method="POST" 
          class="needs-validation" 
          novalidate
        >

          <!-- Star Rating -->
          <div class="mb-3">
            <label class="form-label">Rating</label>

            <fieldset class="starability-slot">
              <input type="radio" id="rate1" name="review[rating]" value="1" required />
              <label for="rate1" title="Terrible">1 star</label>

              <input type="radio" id="rate2" name="review[rating]" value="2" />
              <label for="rate2" title="Not good">2 stars</label>

              <input type="radio" id="rate3" name="review[rating]" value="3" />
              <label for="rate3" title="Average">3 stars</label>

              <input type="radio" id="rate4" name="review[rating]" value="4" />
              <label for="rate4" title="Very good">4 stars</label>

              <input type="radio" id="rate5" name="review[rating]" value="5" />
              <label for="rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <!-- Comment -->
          <div class="mb-3">
            <label for="comment" class="form-label">Comment</label>
            <textarea 
              id="comment" 
              name="review[comment]" 
              rows="4" 
              class="form-control" 
              required
            ></textarea>

            <div class="invalid-feedback">
              Please enter a comment.
            </div>
          </div>

          <button type="submit" class="btn btn-outline-dark">
            Submit Review
          </button>

        </form>
      </div>
    </div>
  <% } %>

  <!-- Reviews Section -->
   <% if(listing.reviews.length > 0) { %>
  <div class="mt-5">
   
    <div class="row">
    <h4 class="text-center mb-4">All Reviews</h4>

      <% for (let review of listing.reviews) { %>

        <div class="col-md-6 col-lg-4 mb-3">
          <div class="card h-100 shadow-sm">

            <div class="card-body">
              <h6 class="card-title">
                <strong><%= review.author.username %></strong>
              </h6>

               <p class="starability-result card-text" data-rating="<%= review.rating %>">
                Rated: <%= review.rating %> stars
              </p>

              <p class="card-text">
                <%= review.comment %>
              </p>
            </div>

            <form 
              method="POST"
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
              class="text-center mb-2"
            >
              <button class="btn btn-sm btn-outline-danger">
                Delete Review
              </button>
            </form>

          </div>
        </div>

      <% } %>
    <% } %>>
    </div>
  <div class="col-8 offset-3 mb-3">
   <h3>Where you'll be</h3>
   <div id="map"></div>
  </div>
  </div>

</div>
<script src="/js/map.js"></script>